#!/bin/sh
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if command -v python >/dev/null 2>&1 && python -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    exec python scripts/git_hook_checks.py --staged
elif command -v py >/dev/null 2>&1 && py -3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    exec py -3 scripts/git_hook_checks.py --staged
elif command -v python3 >/dev/null 2>&1 && python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    exec python3 scripts/git_hook_checks.py --staged
fi

echo "iDO hook checks need Python 3.11 or later on PATH." >&2
exit 1
